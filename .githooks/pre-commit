#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

echo "[pre-commit] running make lint"
make lint

echo "[pre-commit] checking for unexpected gitlinks"
./scripts/check_no_gitlinks.sh

echo "[pre-commit] checking staged artifact policy"
./scripts/check_staged_artifact_policy.sh
