+package routing
+
+import "github.com/danabrams/gromit/internal/config"
+
+// ResolveTier determines the effective tier for a phase.
+// Checks methodology.phase_models config for a phase override,
+// falls back to the provided beadTier.
+func ResolveTier(cfg *config.Config, phase, beadTier string) string {
+	if cfg == nil {
+		return beadTier
+	}
+	return cfg.PhaseModelTier(phase, beadTier)
+}
+
+// NextTier returns the next tier in the escalation chain.
+// Returns empty string if escalation is disabled or at the end of the chain.
+func NextTier(cfg *config.Config, currentTier string) string {
+	if cfg == nil {
+		return ""
+	}
+	return cfg.NextEscalationTier(currentTier)
+}
+
+// BeadTier determines the starting tier for a bead based on config strategy.
+func BeadTier(cfg *config.Config, priority int, labels []string, complexity string) string {
+	if cfg == nil {
+		return "medium"
+	}
+	return cfg.BuildTierForStrategy(priority, labels, complexity)
+}
+```
