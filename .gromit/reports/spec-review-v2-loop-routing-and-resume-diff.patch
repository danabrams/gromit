+package loop
+
+// AnalyzeGaps identifies completed beads whose files have been modified.
+// Returns bead IDs that need revalidation.
+func AnalyzeGaps(beadFiles map[string][]string, changedFiles []string) []string {
+	changedSet := make(map[string]struct{}, len(changedFiles))
+	for _, f := range changedFiles {
+		changedSet[f] = struct{}{}
+	}
+
+	var flagged []string
+	for beadID, files := range beadFiles {
+		for _, f := range files {
+			if _, ok := changedSet[f]; ok {
+				flagged = append(flagged, beadID)
+				break
+			}
+		}
+	}
+	sort.Strings(flagged)
+	return flagged
+}
+```
