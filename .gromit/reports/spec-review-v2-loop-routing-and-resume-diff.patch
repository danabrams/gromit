+	"github.com/danabrams/gromit/internal/v2/routing"
+)
+
+// mockProvider implements llmtypes.LLMProvider for testing.
+type mockProvider struct {
+	name string
+}
+
+func (m *mockProvider) Invoke(_ context.Context, _ llmtypes.LLMInvokeRequest) (*llmtypes.LLMInvokeResponse, error) {
+	return &llmtypes.LLMInvokeResponse{Success: true}, nil
+}
+
+func (m *mockProvider) StreamInvoke(_ context.Context, _ llmtypes.LLMStreamInvokeRequest) (*llmtypes.LLMInvokeResponse, error) {
+	return &llmtypes.LLMInvokeResponse{Success: true}, nil
+}
+
+func TestRouter_PhasePreferences_OverrideRatio(t *testing.T) {
+	claude := &mockProvider{name: "claude"}
+	codex := &mockProvider{name: "codex"}
+
+	r := routing.NewRouter(
+		map[string]routing.ProviderEntry{
+			"claude": {Provider: claude, TierModels: map[string]string{"high": "opus"}},
+			"codex":  {Provider: codex, TierModels: map[string]string{"high": "o3"}},
+		},
+		map[string]string{"build": "claude"}, // pin build to claude
+		map[string]int{"claude": 50, "codex": 50},
+		0,
+	)
+
+	// Give claude more invocations so ratio would favor codex
+	r.RecordInvocation("claude")
+	r.RecordInvocation("claude")
+
+	provider, model, err := r.Select("build", "high")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if provider != claude {
+		t.Errorf("phase preference for 'build' should pin to claude, got %v", provider)
+	}
+	if model != "opus" {
+		t.Errorf("expected model 'opus' for tier 'high', got %q", model)
+	}
+}
+
+func TestRouter_RatioBalancing_SelectsUnderusedProvider(t *testing.T) {
+	claude := &mockProvider{name: "claude"}
+	codex := &mockProvider{name: "codex"}
+
+	r := routing.NewRouter(
+		map[string]routing.ProviderEntry{
+			"claude": {Provider: claude, TierModels: map[string]string{"high": "opus"}},
+			"codex":  {Provider: codex, TierModels: map[string]string{"high": "o3"}},
+		},
+		map[string]string{}, // no phase preferences
+		map[string]int{"claude": 50, "codex": 50},
+		0,
+	)
+
+	// Record 2 invocations for claude, none for codex
+	r.RecordInvocation("claude")
+	r.RecordInvocation("claude")
+
+	// Ratio is 50/50, claude is at 100%, codex is at 0% — should select codex
+	provider, model, err := r.Select("any", "high")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if provider != codex {
+		t.Errorf("ratio balancing should select underused codex, got %v", provider)
+	}
+	if model != "o3" {
+		t.Errorf("expected model 'o3' for codex high tier, got %q", model)
+	}
+}
+
+func TestRouter_MarkUnavailable_FallsBackToAlternative(t *testing.T) {
+	claude := &mockProvider{name: "claude"}
+	codex := &mockProvider{name: "codex"}
+
+	r := routing.NewRouter(
+		map[string]routing.ProviderEntry{
+			"claude": {Provider: claude, TierModels: map[string]string{"high": "opus"}},
+			"codex":  {Provider: codex, TierModels: map[string]string{"high": "o3"}},
+		},
+		map[string]string{},
+		map[string]int{"claude": 100, "codex": 0}, // ratio heavily favors claude
+		time.Hour,
+	)
+
+	r.MarkUnavailable("claude")
+
+	provider, _, err := r.Select("any", "high")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if provider != codex {
+		t.Errorf("claude is unavailable, should fall back to codex, got %v", provider)
+	}
+}
+
+func TestRouter_MarkUnavailable_ReenablesAfterCooldown(t *testing.T) {
+	claude := &mockProvider{name: "claude"}
+
+	r := routing.NewRouter(
+		map[string]routing.ProviderEntry{
+			"claude": {Provider: claude, TierModels: map[string]string{"high": "opus"}},
+		},
+		map[string]string{},
+		map[string]int{"claude": 100},
+		1*time.Millisecond, // very short cooldown
+	)
+
+	r.MarkUnavailable("claude")
+
+	// Immediately should be unavailable
+	provider, _, err := r.Select("any", "high")
+	if err == nil && provider == claude {
+		t.Error("claude should be unavailable immediately after MarkUnavailable")
+	}
+
+	// Wait for cooldown to expire
+	time.Sleep(5 * time.Millisecond)
+
+	provider, model, err := r.Select("any", "high")
+	if err != nil {
+		t.Fatalf("unexpected error after cooldown: %v", err)
+	}
+	if provider != claude {
+		t.Errorf("claude should be re-enabled after cooldown, got %v", provider)
+	}
+	if model != "opus" {
+		t.Errorf("expected model 'opus', got %q", model)
