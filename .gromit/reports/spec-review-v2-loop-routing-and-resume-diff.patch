+```go
+package routing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// RoutableProvider is the interface a provider must implement for routing.
+type RoutableProvider interface {
+	Name() string
+	ModelForTier(tier string) string
+}
+
+// Config holds router construction parameters.
+type Config struct {
+	Providers        map[string]RoutableProvider
+	PhasePreferences map[string]string // phase -> provider name
+	Ratio            map[string]int    // provider name -> target percentage
+	Cooldown         time.Duration
+}
+
+// Router handles provider selection with 3-layer routing.
+type Router struct {
+	providers    map[string]RoutableProvider
+	preferences  map[string]string
+	ratio        map[string]int
+	counts       map[string]int
+	unavailable  map[string]time.Time
+	cooldown     time.Duration
+	mu           sync.Mutex
+}
+
+// NewRouter creates a Router from the provided config.
+func NewRouter(cfg Config) *Router {
+	return &Router{
+		providers:   cfg.Providers,
+		preferences: cfg.PhasePreferences,
+		ratio:       cfg.Ratio,
+		counts:      make(map[string]int),
+		unavailable: make(map[string]time.Time),
+		cooldown:    cfg.Cooldown,
+	}
+}
+
+// Select picks a provider for the given phase and tier.
+// Returns the provider, concrete model name, and any error.
+func (r *Router) Select(phase, tier string) (RoutableProvider, string, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	// Layer 1: phase preference
+	if pref, ok := r.preferences[phase]; ok && pref != "any" {
+		if p, model := r.selectIfAvailable(pref, tier); p != nil {
+			return p, model, nil
+		}
+	}
+
+	// Layer 2: ratio balancing
+	if name := r.selectByRatio(); name != "" {
+		if p, model := r.selectIfAvailable(name, tier); p != nil {
+			return p, model, nil
+		}
+	}
+
+	// Layer 3: any available
+	for name := range r.providers {
+		if p, model := r.selectIfAvailable(name, tier); p != nil {
+			return p, model, nil
+		}
+	}
+
+	return nil, "", fmt.Errorf("no providers available for phase %q tier %q", phase, tier)
+}
+
+// MarkUnavailable marks a provider as unavailable for the cooldown duration.
+func (r *Router) MarkUnavailable(name string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.unavailable[name] = time.Now().Add(r.cooldown)
+}
+
+// RecordInvocation increments the invocation count for a provider.
+func (r *Router) RecordInvocation(name string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.counts[name]++
+}
+
+func (r *Router) selectIfAvailable(name, tier string) (RoutableProvider, string) {
+	p, ok := r.providers[name]
+	if !ok {
+		return nil, ""
+	}
+	if until, ok := r.unavailable[name]; ok {
+		if time.Now().Before(until) {
+			return nil, ""
+		}
+		delete(r.unavailable, name)
+	}
+	model := p.ModelForTier(tier)
+	r.counts[name]++
+	return p, model
+}
+
+func (r *Router) selectByRatio() string {
+	if len(r.ratio) == 0 {
+		return ""
+	}
+	totalCount := 0
+	for _, c := range r.counts {
+		totalCount += c
+	}
+	var selected string
+	largestGap := -1.0
+	for name, target := range r.ratio {
+		if _, ok := r.providers[name]; !ok {
+			continue
+		}
+		if until, ok := r.unavailable[name]; ok && time.Now().Before(until) {
+			continue
+		}
+		current := r.counts[name]
+		var pct float64
+		if totalCount > 0 {
+			pct = float64(current) / float64(totalCount) * 100.0
+		}
+		gap := float64(target) - pct
+		if gap > largestGap {
+			largestGap = gap
+			selected = name
+		}
+	}
+	return selected
+}
+```
