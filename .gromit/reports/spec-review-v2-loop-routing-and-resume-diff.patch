+package routing
+
+import (
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/danabrams/gromit/internal/v2/llmtypes"
+)
+
+// ErrNoProviderAvailable is returned when all registered providers are unavailable.
+var ErrNoProviderAvailable = errors.New("no provider available")
+
+// ProviderEntry pairs an LLMProvider with its tier-to-model mapping.
+type ProviderEntry struct {
+	Provider   llmtypes.LLMProvider
+	TierModels map[string]string // abstract tier ("high","medium","low") -> model name
+}
+
+// Router selects an LLM provider and model for a given phase and tier.
+// It implements 3-layer selection: phase preferences → ratio balancing → any available.
+type Router struct {
+	providers        map[string]ProviderEntry
+	phasePreferences map[string]string // phase -> provider name
+	ratio            map[string]int    // provider name -> weight
+	counts           map[string]int    // provider name -> invocation count
+	unavailable      map[string]time.Time
+	cooldown         time.Duration
+	mu               sync.Mutex
+}
+
+// NewRouter constructs a Router.
+//
+//   - providers: registered providers keyed by name
+//   - phasePreferences: optional pin of phase name → provider name
+//   - ratio: provider weight map for ratio balancing (values are relative weights)
+//   - cooldown: duration a provider stays marked unavailable after MarkUnavailable
+func NewRouter(
+	providers map[string]ProviderEntry,
+	phasePreferences map[string]string,
+	ratio map[string]int,
+	cooldown time.Duration,
+) *Router {
+	return &Router{
+		providers:        providers,
+		phasePreferences: phasePreferences,
+		ratio:            ratio,
+		counts:           make(map[string]int),
+		unavailable:      make(map[string]time.Time),
+		cooldown:         cooldown,
+	}
+}
+
+// Select picks a provider and concrete model name for the given phase and tier.
+// Returns ErrNoProviderAvailable if all providers are currently unavailable.
+func (r *Router) Select(phase, tier string) (llmtypes.LLMProvider, string, error) {
+	// Layer 1: phase preference
+	if pref, ok := r.phasePreferences[phase]; ok && pref != "" && pref != "any" {
+		if p, model, ok := r.pickProvider(pref, tier); ok {
+			return p, model, nil
+		}
+	}
+
+	// Layer 2: ratio balancing
+	if name := r.selectByRatio(); name != "" {
+		if p, model, ok := r.pickProvider(name, tier); ok {
+			return p, model, nil
+		}
+	}
+
+	// Layer 3: any available
+	for name := range r.providers {
+		if p, model, ok := r.pickProvider(name, tier); ok {
+			return p, model, nil
+		}
+	}
+
+	return nil, "", ErrNoProviderAvailable
+}
+
+// RecordInvocation increments the invocation count for the named provider.
+func (r *Router) RecordInvocation(name string) {
+	r.mu.Lock()
+	r.counts[name]++
+	r.mu.Unlock()
+}
+
+// MarkUnavailable marks the named provider unavailable for the configured cooldown period.
+func (r *Router) MarkUnavailable(name string) {
+	r.mu.Lock()
+	r.unavailable[name] = time.Now().Add(r.cooldown)
+	r.mu.Unlock()
+}
+
+// isAvailable reports whether the named provider is currently available.
+// Must NOT be called while holding r.mu.
+func (r *Router) isAvailable(name string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	until, marked := r.unavailable[name]
+	if !marked {
+		return true
+	}
+	if time.Now().After(until) {
+		delete(r.unavailable, name)
+		return true
+	}
+	return false
+}
+
+// pickProvider returns the provider and model if the named provider is available.
+func (r *Router) pickProvider(name, tier string) (llmtypes.LLMProvider, string, bool) {
+	entry, ok := r.providers[name]
+	if !ok {
+		return nil, "", false
+	}
+	if !r.isAvailable(name) {
+		return nil, "", false
+	}
+	model := entry.TierModels[tier]
+	return entry.Provider, model, true
+}
+
+// selectByRatio returns the provider name that is furthest below its target ratio.
+func (r *Router) selectByRatio() string {
+	if len(r.ratio) == 0 {
+		return ""
+	}
+
+	r.mu.Lock()
+	countsSnapshot := make(map[string]int, len(r.counts))
+	for k, v := range r.counts {
+		countsSnapshot[k] = v
+	}
+	r.mu.Unlock()
+
+	total := 0
+	for _, c := range countsSnapshot {
+		total += c
+	}
+
+	var selected string
+	largestGap := -1.0
+
+	for name, weight := range r.ratio {
+		if !r.isAvailable(name) {
+			continue
+		}
+		var currentPct float64
+		if total > 0 {
+			currentPct = float64(countsSnapshot[name]) / float64(total) * 100.0
+		}
+		gap := float64(weight) - currentPct
+		if gap > largestGap {
+			largestGap = gap
+			selected = name
+		}
+	}
+
+	return selected
+}
