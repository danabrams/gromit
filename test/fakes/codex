#!/usr/bin/env bash
# Fake codex CLI for testing

set -euo pipefail

readonly jsonl_assistant_template='{"type":"assistant","message":{"content":[{"type":"text","text":%s}]}}'
readonly jsonl_result_template='{"type":"result","result":%s}'

record_call() {
    if [[ -n "${TEST_CALL_LOG:-}" ]]; then
        echo "codex $*" >> "$TEST_CALL_LOG"
    fi
}

emit_jsonl_fixture() {
    local fixture_path="$1"
    local content escaped_content

    content=$(cat "$fixture_path")
    escaped_content=$(echo "$content" | jq -Rs .)
    printf "$jsonl_assistant_template\n" "$escaped_content"
    printf "$jsonl_result_template\n" "$escaped_content"
}

record_call "$@"

if [[ -n "${CODEX_DELAY:-}" ]]; then
    sleep "${CODEX_DELAY}"
fi

# Read and discard stdin (codex expects prompt on stdin)
cat > /dev/null

if [[ -n "${CODEX_FAIL:-}" ]] && [[ "${CODEX_FAIL}" != "0" ]]; then
    exit_code="${CODEX_FAIL}"
    if ! [[ "$exit_code" =~ ^[0-9]+$ ]]; then
        exit_code=1
    fi
    echo "codex: simulated failure" >&2
    exit "$exit_code"
fi

fixture_file="${CODEX_FIXTURE:-}"
if [[ -z "$fixture_file" ]]; then
    echo "codex: CODEX_FIXTURE env var not set" >&2
    exit 1
fi

if [[ ! -f "$fixture_file" ]]; then
    echo "codex: fixture file not found: $fixture_file" >&2
    exit 1
fi

jsonl_mode=0
for arg in "$@"; do
    if [[ "$arg" == "--jsonl" ]] || [[ "$arg" == "--json" ]]; then
        jsonl_mode=1
    fi
done

if [[ $jsonl_mode -eq 1 ]]; then
    emit_jsonl_fixture "$fixture_file"
else
    cat "$fixture_file"
fi
