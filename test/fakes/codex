#!/usr/bin/env bash
# Fake codex CLI for testing

set -euo pipefail

if [[ -n "${TEST_CALL_LOG:-}" ]]; then
    echo "codex $*" >> "$TEST_CALL_LOG"
fi

cat > /dev/null

fixture_file="${CODEX_FIXTURE:-}"
if [[ -z "$fixture_file" ]]; then
    echo "codex: CODEX_FIXTURE env var not set" >&2
    exit 1
fi

if [[ ! -f "$fixture_file" ]]; then
    echo "codex: fixture file not found: $fixture_file" >&2
    exit 1
fi

jsonl_mode=0
for arg in "$@"; do
    if [[ "$arg" == "--jsonl" ]] || [[ "$arg" == "--json" ]]; then
        jsonl_mode=1
    fi
done

if [[ $jsonl_mode -eq 1 ]]; then
    content=$(cat "$fixture_file")
    escaped_content=$(echo "$content" | jq -Rs .)
    echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":$escaped_content}]}}"
    echo "{\"type\":\"result\",\"result\":$escaped_content}"
else
    cat "$fixture_file"
fi
