#!/usr/bin/env bash
# Fake claude CLI for testing
# Records invocations, reads and discards stdin, returns canned fixture output

set -euo pipefail

# Record invocation to call log if TEST_CALL_LOG is set
if [[ -n "${TEST_CALL_LOG:-}" ]]; then
    echo "claude $*" >> "$TEST_CALL_LOG"
fi

# Read and discard stdin (claude expects prompt on stdin)
cat > /dev/null

# Check for CLAUDE_FAIL error mode
if [[ "${CLAUDE_FAIL:-0}" == "1" ]]; then
    echo "claude: simulated failure" >&2
    exit 1
fi

# Check if we're in stream-json mode and extract model
stream_json=0
model=""
for ((i=1; i<=$#; i++)); do
    arg="${!i}"
    if [[ "$arg" == "stream-json" ]]; then
        stream_json=1
    fi
    if [[ "$arg" == "--model" ]]; then
        j=$((i+1))
        model="${!j}"
    fi
done

# Select fixture based on model if model-specific fixtures are provided
# CLAUDE_FIXTURE_<MODEL> overrides CLAUDE_FIXTURE
# Special handling for _ONCE mode: after first failure, use _SUCCESS fixture if available
fixture_var="CLAUDE_FIXTURE"
if [[ -n "$model" ]]; then
    model_upper=$(echo "$model" | tr '[:lower:]' '[:upper:]')

    # Check if we're in fail-once mode and have already failed
    fail_once_var="CLAUDE_FAIL_${model_upper}_ONCE"
    state_file="${TEST_DIR:-/tmp}/.claude_fail_${model}_once_state"

    if [[ "${!fail_once_var:-0}" == "1" ]] && [[ -f "$state_file" ]]; then
        # We've already failed once - use success fixture if available
        success_fixture_var="CLAUDE_FIXTURE_${model_upper}_SUCCESS"
        if [[ -n "${!success_fixture_var:-}" ]]; then
            fixture_var="$success_fixture_var"
        fi
    else
        # Not in fail-once mode or haven't failed yet - use regular model fixture
        model_fixture_var="CLAUDE_FIXTURE_${model_upper}"
        if [[ -n "${!model_fixture_var:-}" ]]; then
            fixture_var="$model_fixture_var"
        fi
    fi
fi

fixture_file="${!fixture_var}"

# Get fixture content from CLAUDE_FIXTURE env var
if [[ -z "$fixture_file" ]]; then
    echo "claude: CLAUDE_FIXTURE env var not set" >&2
    exit 1
fi

if [[ ! -f "$fixture_file" ]]; then
    echo "claude: fixture file not found: $fixture_file" >&2
    exit 1
fi

# Check if this model should fail (CLAUDE_FAIL_<MODEL>=1)
if [[ -n "$model" ]]; then
    model_upper=$(echo "$model" | tr '[:lower:]' '[:upper:]')
    fail_var="CLAUDE_FAIL_${model_upper}"
    fail_once_var="CLAUDE_FAIL_${model_upper}_ONCE"

    # Check for one-time failure mode (fails first invocation, succeeds on subsequent)
    if [[ "${!fail_once_var:-0}" == "1" ]] && [[ $stream_json -eq 1 ]]; then
        # Only fail on stream-json invocations (build phase, not validation or analysis)
        # Use a state file to track if we've already failed once
        state_file="${TEST_DIR:-/tmp}/.claude_fail_${model}_once_state"

        if [[ ! -f "$state_file" ]]; then
            # First invocation - fail it
            touch "$state_file"
            content=$(cat "$fixture_file")
            escaped_content=$(echo "$content" | jq -Rs .)
            echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":$escaped_content}]}}"
            echo "{\"type\":\"result\",\"result\":$escaped_content}"
            exit 1
        fi
        # Subsequent invocations - succeed (fall through to normal fixture output)
    elif [[ "${!fail_var:-0}" == "1" ]]; then
        # Always fail mode
        # Output the fixture (which should contain error text) then exit with error code
        if [[ $stream_json -eq 1 ]]; then
            content=$(cat "$fixture_file")
            escaped_content=$(echo "$content" | jq -Rs .)
            echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":$escaped_content}]}}"
            echo "{\"type\":\"result\",\"result\":$escaped_content}"
        else
            cat "$fixture_file"
        fi
        exit 1
    fi
fi

# Output fixture content based on mode
if [[ $stream_json -eq 1 ]]; then
    # In stream-json mode, wrap the fixture content in JSON events
    # Read the fixture line by line and emit as stream-json events

    # Emit an assistant message with the fixture content as text
    content=$(cat "$fixture_file")

    # Escape JSON special characters in content
    escaped_content=$(echo "$content" | jq -Rs .)

    # Emit assistant event with text content
    echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":$escaped_content}]}}"

    # Emit result event with the same content
    echo "{\"type\":\"result\",\"result\":$escaped_content}"
else
    # Plain mode: just output the fixture content directly
    cat "$fixture_file"
fi

exit 0
