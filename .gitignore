# Binary (in root directory only)
/gromit

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test binaries
*.test

# Scratch notes
debug.md
devug.md
fixed.md
fixes.md
progress.md
testfailure.md
testfix.md

# Test coverage
coverage.out

# Gromit runner
**/.gromit/logs/
**/.gromit/tmp/
.gromit/integration-queue.json
.gromit/status.json
.gromit/state.json
.gromit/stats.json
.gromit/interactive-state.json
.gromit/metrics/iteration_metrics.jsonl
.gromit/metrics/process_trend.json

# Codex runtime artifacts
.codex-home/

# Ephemeral gromit worktree artifacts
/.-gromit-*

# Runtime/local data stores (must never be committed)
/.dolt/
/.doltcfg/
/beads_gromit/

# Runtime lock/state artifacts
cmd/gromit/.gromit/interactive-state.json.lock
.gromit/interactive-state.json.lock

# Benchmark run outputs are ephemeral; curated fixtures belong under test/fixtures
cmd/gromit/.gromit/benchmarks/results/
.gromit/benchmarks/results/

# Raw run outputs are ephemeral; keep curated summaries in .gromit/reports/curated/
.gromit/reports/runs/

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads runtime logs
.beads/*.log
.beads/*.launchd.err.log
.beads/*.launchd.out.log
.beads/remotes/
.worktrees/

# Fixture repos (nested git repos for testing)
test/fixture-repos/
gromit-next
